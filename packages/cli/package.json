{
  "name": "@cy-agent/cli",
  "version": "0.0.0",
  "type": "module",
  "description": "Coding agent CLI (interactive REPL + non-interactive one-shot mode, HITL approval host)",
  "bin": {
    "cy-agent": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@cy-agent/agent": "workspace:*",
    "@cy-agent/openai-provider": "workspace:*",
    "@cy-agent/protocol": "workspace:*",
    "@cy-agent/storage": "workspace:*",
    "@cy-agent/tools": "workspace:*"
  }
}
