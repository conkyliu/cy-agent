{
  "name": "@cy-agent/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron desktop shell: main process hosts the agent runtime, renderer consumes the AgentEvent stream",
  "author": "cy-agent contributors",
  "main": "./dist/main/index.cjs",
  "scripts": {
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "esbuild main/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/index.cjs",
    "build:preload": "esbuild preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.cjs",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dev": "node scripts/dev.mjs",
    "release": "electron-builder --mac",
    "release:win": "electron-builder --win",
    "release:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@cy-agent/agent": "workspace:*",
    "@cy-agent/openai-provider": "workspace:*",
    "@cy-agent/protocol": "workspace:*",
    "@cy-agent/storage": "workspace:*",
    "@cy-agent/tools": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.0.0"
  }
}
